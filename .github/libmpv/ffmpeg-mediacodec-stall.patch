diff --git a/libavcodec/mediacodecdec.c b/libavcodec/mediacodecdec.c
index 2146490..5b49889 100644
--- a/libavcodec/mediacodecdec.c
+++ b/libavcodec/mediacodecdec.c
@@ -31,6 +31,7 @@
 #include "libavutil/intreadwrite.h"
 #include "libavutil/pixfmt.h"
 #include "libavutil/internal.h"
+#include "libavutil/time.h"
 
 #include "avcodec.h"
 #include "codec_internal.h"
@@ -440,11 +441,15 @@ done:
     return ret;
 }
 
+/* How long the codec may take no input and give no output before decoding gives up (see below) */
+#define STALL_TIMEOUT_US 1000000
+
 static int mediacodec_receive_frame(AVCodecContext *avctx, AVFrame *frame)
 {
     MediaCodecH264DecContext *s = avctx->priv_data;
     int ret;
     ssize_t index;
+    int64_t stalled_since = 0;
 
     /* In delay_flush mode, wait until the user has released or rendered
        all retained frames. */
@@ -473,11 +478,30 @@ static int mediacodec_receive_frame(AVCodecContext *avctx, AVFrame *frame)
                  * return EAGAIN, which violate the design.
                  */
                 if (ff_AMediaCodec_infoTryAgainLater(s->ctx->codec, index) &&
-                    ret == AVERROR(EAGAIN))
+                    ret == AVERROR(EAGAIN)) {
+                    /* A codec that neither takes input nor gives output would
+                     * keep us (and the caller's thread) here forever: seen
+                     * with c2.exynos.h264.decoder on a Pixel 8 Pro, see
+                     * https://trac.ffmpeg.org/ticket/11363 . Give up after a
+                     * while, so the caller can fall back to another decoder. */
+                    int64_t now = av_gettime_relative();
+                    if (!stalled_since) {
+                        stalled_since = now;
+                    } else if (now - stalled_since > STALL_TIMEOUT_US) {
+                        av_log(avctx, AV_LOG_ERROR, "MediaCodec stalled: no input "
+                               "buffer and no output for %"PRId64" ms\n",
+                               (now - stalled_since) / 1000);
+                        return AVERROR_EXTERNAL;
+                    } else if (now - stalled_since > 20000) {
+                        /* the output wait is 0 until the first frame: don't spin */
+                        av_usleep(2000);
+                    }
                     continue;
+                }
                 return ret;
             }
             s->ctx->current_input_buffer = index;
+            stalled_since = 0;
         }
 
         /* try to flush any buffered packet data */
